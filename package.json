{
  "name": "rachio-cli",
  "version": "0.1.0",
  "description": "Command-line interface for Rachio smart sprinkler controllers — start zones, set rain delays, and run schedules from your terminal, with JSON output for scripting.",
  "type": "module",
  "bin": {
    "rachio": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "rachio",
    "rachio-api",
    "rachio-cli",
    "irrigation",
    "sprinkler",
    "sprinkler-controller",
    "watering",
    "lawn",
    "cli",
    "command-line",
    "smart-home",
    "home-automation",
    "iot",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/alexleventer/rachio-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexleventer/rachio-cli.git"
  },
  "bugs": {
    "url": "https://github.com/alexleventer/rachio-cli/issues"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
